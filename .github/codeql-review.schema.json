{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact, expiring Meridian CodeQL review records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hashAlgorithm", "reviews"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "hashAlgorithm": { "const": "sha256-lf" },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ruleId", "path", "partialFingerprints", "reason", "reviewedBy", "reviewedAt", "expiresAt", "evidence", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,79}$" },
          "ruleId": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "partialFingerprints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primaryLocationLineHash"],
            "properties": {
              "primaryLocationLineHash": { "type": "string", "pattern": "^[a-f0-9]{16,64}:[1-9][0-9]*$" }
            }
          },
          "reason": { "type": "string", "minLength": 40 },
          "reviewedBy": { "type": "string", "minLength": 5 },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
